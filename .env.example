# =========================================================
# KisanMitra AI — Frontend Environment Configuration Template
# Copy this file or set variables in your deployment environment
# =========================================================

# Frontend Server Port (default: 8080)
PORT=8080

# Backend API Base URL
# Default local development server provides GET /api/mandi/prices on http://127.0.0.1:8080
# For remote or separate production backends, set full URL (e.g., https://api.kisanmitra.ai)
BACKEND_API_BASE_URL=http://127.0.0.1:8080

# Mandi Prices Endpoint Path
MANDI_API_ENDPOINT=/api/mandi/prices

# Optional Google OAuth 2.0 Web Client ID for Google Identity Services (GIS)
# Generate in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Leave empty to keep the integration-ready demo mode active
GOOGLE_CLIENT_ID=
