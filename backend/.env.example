# KisanMitra AI — Environment Configuration Template
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001

# Database Configuration (SQLite default for initial local development)
DATABASE_URL=sqlite:///./kisanmitra.db

# CORS Allowed Origins (comma-separated list for frontend dev servers)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini AI Configuration (Official google-genai SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30.0

# Firebase Authentication Configuration (Firebase Admin SDK - Server-Side Only)
# Option A: Direct credentials
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Option B (Alternative): Path to service account JSON file (e.g. serviceAccountKey.json - NEVER COMMIT)
FIREBASE_CREDENTIALS_PATH=


# OpenWeather API Configuration
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
GEOCODING_API_BASE_URL=https://api.openweathermap.org/geo/1.0
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_TIMEOUT_SECONDS=10.0

# Mandi / Market Price Configuration (data.gov.in / Agmarknet)
MANDI_API_KEY=
MANDI_API_BASE_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
MANDI_DATA_MODE=AUTO
MANDI_CACHE_TTL_SECONDS=600
MANDI_TIMEOUT_SECONDS=10.0


